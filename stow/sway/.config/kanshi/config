# kanshi output profiles — automatically applies monitor layout on connect/disconnect.
# Note: kanshictl is not available (old kanshi version). To switch between profiles
# with the same set of connected outputs, use swaymsg output directly (see toggle-Sensio-M4-laptop-position.sh).

profile laptop_only {
    output "Sharp Corporation 0x14D0 Unknown" enable position 0,0
    exec ~/.config/sway/sway-workspace-config.sh laptop_only
}

# Sensio-M4: two Lenovo P27h-28 externals only; built-in screen disabled.
#   V90DFW2V → left external  (workspaces 1-5)
#   V90DFVTC → right external (workspaces 6-10)
profile Sensio-M4 {
    output "Lenovo Group Limited P27h-28 V90DFW2V" enable mode 2560x1440 position 0,0
    output "Lenovo Group Limited P27h-28 V90DFVTC" enable mode 2560x1440 position 2560,0
    output "Sharp Corporation 0x14D0 Unknown" disable
    exec ~/.config/sway/sway-workspace-config.sh Sensio-M4
}

profile Curved-GAG {
    output "Sharp Corporation 0x14D0 Unknown" enable position 0,0
    output "Samsung Electric Company C34H89x H4ZT803398" enable position 1920,0
    exec ~/.config/sway/sway-workspace-config.sh Curved-GAG
}
