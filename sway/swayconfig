# vi: ft=conf
set $alt Mod1
set $mod Mod4
set $ctrl Control
#font pango:FiraCode Nerd Font Mono 10
font pango:DejaVuSansM Nerd Font 14

# Export sway/Wayland environment to systemd user session and D-Bus.
# Required for xdg-desktop-portal-wlr (and other user services) to find the compositor.
# exec_always so this also runs on swaymsg reload.
exec_always systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK XCURSOR_THEME=Adwaita XCURSOR_SIZE=24

# Idle management and screen locking (replaces xss-lock + i3lock, which are X11-only)
# Requires: swayidle, swaylock
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg output eDP-1 enable; swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f' \
    after-resume 'swaymsg output eDP-1 enable; sleep 1; swaymsg "output * dpms on"'

# Status bar (waybar replaces the sway bar block; config in sway/waybar/)
exec waybar
# Notification daemon
exec mako
# nm-applet handles connection prompts and VPN authentication (waybar shows network status)
exec nm-applet --indicator

# Volume control via wpctl (PipeWire-native; waybar wireplumber module updates automatically)
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Cursor theme for both native Wayland clients and XWayland
seat seat0 xcursor_theme Adwaita 24

# Use Mouse+$mod to drag floating windows to their wanted position
# 'normal' keyword is required in sway (was implicit in i3)
floating_modifier $mod normal
floating_minimum_size 100 x 50
floating_maximum_size 1600 x 900

# start a terminal
# i3-sensible-terminal is X11-only; using foot (native Wayland)
bindsym $mod+Return exec foot

# kill focused window
bindsym $mod+Shift+q kill

# app launcher
bindsym $mod+d exec fuzzel

# 1password quick access (Wayland workaround; 1password's built-in shortcut doesn't work under Wayland)
bindsym $ctrl+Shift+space exec 1password --quick-access

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+shift+v split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# sway has no 'restart' command; reload is the closest equivalent
bindsym $mod+Shift+r reload
# exit sway (i3-nagbar replaced with swaynag)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window's width.
        # Pressing right will grow the window's width.
        # Pressing up will shrink the window's height.
        # Pressing down will grow the window's height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Bar is handled by waybar (launched in exec section above)
# See sway/waybar/config and sway/waybar/style.css

# Keyboard layout toggle
# kb_toggle.sh used setxkbmap (X11-only). In sway, configure layouts in an input
# block and switch between them at runtime.
input type:keyboard {
    xkb_layout "us,no"
}
# Cycles to next configured layout
bindsym $mod+space exec swaymsg input type:keyboard xkb_switch_layout next

# Caps/Ctrl swap toggle
# kb_swapcaps.sh used setxkbmap (X11-only). Sway handles this via xkb_options.
# To permanently enable swap, add 'xkb_options ctrl:swapcaps' to the input block above.
# The binding below toggles the option at runtime (clears all options when pressed):
bindsym Control+Shift+$alt+space exec swaymsg input type:keyboard xkb_options ctrl:swapcaps

# Adjust backlight
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86MonBrightnessUp exec brightnessctl set 10%+

# Shutdown mode (i3exit replaced with direct swaymsg/systemctl calls)
set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    bindsym l exec swaylock -f, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym s exec systemctl suspend, mode "default"
    bindsym h exec systemctl hibernate, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym Shift+s exec systemctl poweroff, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $ctrl+$alt+Delete mode "$mode_system"

# Scratchpad
bindsym $mod+Shift+BackSpace move scratchpad
# Slack and tidal-hifi are Electron apps; they run via XWayland so class= still works.
# If you launch them with --ozone-platform=wayland, switch to app_id= instead.
bindsym $mod+BackSpace [class="Slack"] scratchpad show
bindsym $mod+backslash scratchpad show
bindsym $mod+m [class="tidal-hifi"] scratchpad show

# Start Slack and move to scratchpad (i3-msg replaced with swaymsg)
exec slack
exec sleep 2 && swaymsg "[class=\"Slack\"] move scratchpad"

# Screenshots: grim captures, slurp selects region, swappy annotates
bindsym $mod+p exec grim -g "$(slurp)" - | swappy -f -

# Allow popups in fullscreen
popup_during_fullscreen smart

# NOTE: setup-nvidia.sh (X11 display setup for Pop!_OS) has been removed.
# NVIDIA + sway requires environment variables, typically set in /etc/environment
# or ~/.config/environment.d/. See:
# https://wiki.archlinux.org/title/sway#NVIDIA_proprietary_driver

# NOTE: xrdb is X11-only and has been removed.

exec_always /usr/bin/1password --silent

# kanshi watches for output connect/disconnect events and applies the matching profile.
# On activation, kanshi calls sway-workspace-config.sh which writes
# ~/.config/sway/workspace-outputs.conf and triggers a sway reload.
# Use `kanshictl switch <profile>` to manually switch profiles with the same output set
# (e.g. same monitors but laptop repositioned).
exec kanshi

# Workspace-to-output assignments written by sway-workspace-config.sh via kanshi.
# File is created on first profile activation; sway silently skips it if missing.
include ~/.config/sway/workspace-outputs.conf
