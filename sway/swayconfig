# vi: ft=conf
set $alt Mod1
set $mod Mod4
set $ctrl Control
#font pango:FiraCode Nerd Font Mono 10
font pango:DejaVuSansM Nerd Font 10

# Idle management and screen locking (replaces xss-lock + i3lock, which are X11-only)
# Requires: swayidle, swaylock
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f'

# Tray applets
# nm-applet requires --indicator flag on Wayland
exec nm-applet --indicator
# blueman-applet has inconsistent Wayland support; may fall back to XWayland
exec blueman-applet
# flameshot has partial Wayland support; see $mod+p binding below for alternatives
exec flameshot

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
# 'normal' keyword is required in sway (was implicit in i3)
floating_modifier $mod normal
floating_minimum_size 100 x 50
floating_maximum_size 1600 x 900

# start a terminal
# i3-sensible-terminal is X11-only; using foot (native Wayland)
bindsym $mod+Return exec foot

# kill focused window
bindsym $mod+Shift+q kill

# app launcher
# dmenu_run is X11-only; using bemenu-run (Wayland-native dmenu clone)
# Note: bemenu font argument syntax may need adjustment for your font setup
bindsym $mod+d exec bemenu-run --fn 'terminus-font normal 24'
# Alternative: wofi
# bindsym $mod+d exec wofi --show run

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+shift+v split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# sway has no 'restart' command; reload is the closest equivalent
bindsym $mod+Shift+r reload
# exit sway (i3-nagbar replaced with swaynag)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window's width.
        # Pressing right will grow the window's width.
        # Pressing up will shrink the window's height.
        # Pressing down will grow the window's height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Start sway bar with i3status (i3status is compatible with sway's bar)
bar {
    status_command i3status
}

# Keyboard layout toggle
# kb_toggle.sh used setxkbmap (X11-only). In sway, configure layouts in an input
# block and switch between them at runtime.
# TODO: Add your keyboard layouts to the input block below, then this binding
#       will cycle through them.
input type:keyboard {
    # xkb_layout "us,no"
    # xkb_options "grp:win_space_toggle"
}
# Cycles to next configured layout (requires xkb_layout with multiple entries above)
bindsym $mod+space exec swaymsg input type:keyboard xkb_switch_layout next

# Caps/Ctrl swap toggle
# kb_swapcaps.sh used setxkbmap (X11-only). Sway handles this via xkb_options.
# To permanently enable swap, add 'xkb_options ctrl:swapcaps' to the input block above.
# The binding below toggles the option at runtime (clears all options when pressed):
bindsym Control+Shift+$alt+space exec swaymsg input type:keyboard xkb_options ctrl:swapcaps

# Adjust backlight
bindsym XF86MonBrightnessDown exec light -T 0.9
bindsym XF86MonBrightnessUp exec light -T 1.1

# Shutdown mode (i3exit replaced with direct swaymsg/systemctl calls)
set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    bindsym l exec swaylock -f, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym s exec systemctl suspend, mode "default"
    bindsym h exec systemctl hibernate, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym Shift+s exec systemctl poweroff, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $ctrl+$alt+Delete mode "$mode_system"

# Scratchpad
bindsym $mod+Shift+BackSpace move scratchpad
# Slack and tidal-hifi are Electron apps; they run via XWayland so class= still works.
# If you launch them with --ozone-platform=wayland, switch to app_id= instead.
bindsym $mod+BackSpace [class="Slack"] scratchpad show
bindsym $mod+backslash scratchpad show
bindsym $mod+m [class="tidal-hifi"] scratchpad show

# Start Slack and move to scratchpad (i3-msg replaced with swaymsg)
exec slack
exec sleep 2 && swaymsg "[class=\"Slack\"] move scratchpad"

# Screenshots
# flameshot has partial Wayland support and may not work correctly.
# Native Wayland alternative using grim + slurp:
# bindsym $mod+p exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym $mod+p exec flameshot gui

# Allow popups in fullscreen
popup_during_fullscreen smart

# NOTE: setup-nvidia.sh (X11 display setup for Pop!_OS) has been removed.
# NVIDIA + sway requires environment variables, typically set in /etc/environment
# or ~/.config/environment.d/. See:
# https://wiki.archlinux.org/title/sway#NVIDIA_proprietary_driver

# NOTE: xrdb is X11-only and has been removed.

exec_always /usr/bin/1password --silent

### Dynamic workspace to output mappings
# Verify output names match your system with: swaymsg -t get_outputs
workspace 6 output eDP-1
workspace 7 output eDP-1
workspace 8 output eDP-1
workspace 9 output eDP-1
workspace 10 output eDP-1
### End dynamic section
